{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping SwitchDeck /metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "gauge",
      "name": "Gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "bargauge",
      "name": "Bar gauge",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "SwitchDeck — TP-Link smart switch monitoring. Displays per-switch and per-port status, traffic counters, PoE consumption, and network feature state.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["switchdeck", "network", "switches", "tplink"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "definition": "label_values(switchdeck_switch_up, switch_name)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "label": "Switch",
        "multi": true,
        "name": "switch",
        "options": [],
        "query": {
          "query": "label_values(switchdeck_switch_up, switch_name)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "SwitchDeck",
  "uid": "switchdeck-overview",
  "version": 1,
  "panels": [

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "title": "Switch Overview",
      "type": "row"
    },

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"options": {"0": {"color": "red", "index": 0, "text": "Offline"}, "1": {"color": "green", "index": 1, "text": "Online"}}, "type": "value"}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "title": "Switch Status",
      "type": "stat",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "switchdeck_switch_up{switch_name=~\"$switch\"}",
          "legendFormat": "{{switch_name}}",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "id": 2,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "title": "Ports Up",
      "type": "stat",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "switchdeck_switch_ports_up{switch_name=~\"$switch\"}",
          "legendFormat": "{{switch_name}}",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 4}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "id": 3,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "title": "Ports Down",
      "type": "stat",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "switchdeck_switch_ports_down{switch_name=~\"$switch\"}",
          "legendFormat": "{{switch_name}}",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"fixedColor": "blue", "mode": "fixed"},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "title": "Total Ports",
      "type": "stat",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "switchdeck_switch_ports_total{switch_name=~\"$switch\"}",
          "legendFormat": "{{switch_name}}",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"options": {"0": {"color": "red", "index": 0, "text": "Failed"}, "1": {"color": "green", "index": 1, "text": "OK"}}, "type": "value"}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1},
      "id": 5,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "title": "Scrape Success",
      "type": "stat",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "switchdeck_scrape_success{switch_name=~\"$switch\"}",
          "legendFormat": "{{switch_name}}",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"fixedColor": "text", "mode": "fixed"},
          "unit": "dateTimeFromNow"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1},
      "id": 6,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "title": "Last Collected",
      "type": "stat",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "switchdeck_switch_last_collected_timestamp_seconds{switch_name=~\"$switch\"} * 1000",
          "legendFormat": "{{switch_name}}",
          "refId": "A"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "id": 101,
      "title": "Port Status",
      "type": "row"
    },

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false}, "unit": "short"},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Link"},
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {"options": {"0": {"color": "red", "index": 0, "text": "Down"}, "1": {"color": "green", "index": 1, "text": "Up"}}, "type": "value"}
                ]
              },
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Enabled"},
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {"options": {"0": {"color": "orange", "index": 0, "text": "Disabled"}, "1": {"color": "green", "index": 1, "text": "Enabled"}}, "type": "value"}
                ]
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Speed (Mbps)"},
            "properties": [
              {"id": "unit", "value": "short"},
              {"id": "custom.width", "value": 110}
            ]
          }
        ]
      },
      "gridPos": {"h": 10, "w": 14, "x": 0, "y": 6},
      "id": 7,
      "options": {
        "cellHeight": "sm",
        "footer": {"countRows": false, "enablePagination": false, "fields": "", "reducer": ["sum"], "show": false},
        "showHeader": true,
        "sortBy": [{"displayName": "Port", "desc": false}]
      },
      "title": "Port Status",
      "transformations": [
        {"id": "merge", "options": {}},
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "__name__": true, "instance": true, "job": true, "switch_id": true},
            "renameByName": {
              "switch_name": "Switch",
              "port": "Port",
              "Value #A": "Link",
              "Value #B": "Enabled",
              "Value #C": "Speed (Mbps)"
            },
            "indexByName": {
              "Switch": 0,
              "Port": 1,
              "Link": 2,
              "Enabled": 3,
              "Speed (Mbps)": 4
            }
          }
        },
        {"id": "sortBy", "options": {"fields": [{"displayName": "Port", "desc": false}]}}
      ],
      "type": "table",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "switchdeck_port_up{switch_name=~\"$switch\"}",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "switchdeck_port_enabled{switch_name=~\"$switch\"}",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "switchdeck_port_speed_mbps{switch_name=~\"$switch\"}",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "C"
        }
      ]
    },

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "never"},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 10, "w": 10, "x": 14, "y": 6},
      "id": 8,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "title": "Ports Up / Down Over Time",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "switchdeck_switch_ports_up{switch_name=~\"$switch\"}",
          "legendFormat": "Up — {{switch_name}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "switchdeck_switch_ports_down{switch_name=~\"$switch\"}",
          "legendFormat": "Down — {{switch_name}}",
          "refId": "B"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 16},
      "id": 102,
      "title": "Traffic",
      "type": "row"
    },

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 5, "showPoints": "never"},
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 17},
      "id": 9,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "title": "Port Throughput (Bytes/s)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "irate(switchdeck_port_rx_bytes_total{switch_name=~\"$switch\"}[5m])",
          "legendFormat": "RX {{switch_name}}:{{port}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "irate(switchdeck_port_tx_bytes_total{switch_name=~\"$switch\"}[5m])",
          "legendFormat": "TX {{switch_name}}:{{port}}",
          "refId": "B"
        }
      ]
    },

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 5, "showPoints": "never"},
          "unit": "pps"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 25},
      "id": 10,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "title": "Port Packets/s",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "irate(switchdeck_port_rx_packets_total{switch_name=~\"$switch\"}[5m])",
          "legendFormat": "RX {{switch_name}}:{{port}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "irate(switchdeck_port_tx_packets_total{switch_name=~\"$switch\"}[5m])",
          "legendFormat": "TX {{switch_name}}:{{port}}",
          "refId": "B"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 33},
      "id": 103,
      "title": "Errors & Drops",
      "type": "row"
    },

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10, "showPoints": "never"},
          "unit": "pps"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 34},
      "id": 11,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "title": "Port Errors/s",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "irate(switchdeck_port_rx_errors_total{switch_name=~\"$switch\"}[5m])",
          "legendFormat": "RX Err {{switch_name}}:{{port}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "irate(switchdeck_port_tx_errors_total{switch_name=~\"$switch\"}[5m])",
          "legendFormat": "TX Err {{switch_name}}:{{port}}",
          "refId": "B"
        }
      ]
    },

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10, "showPoints": "never"},
          "unit": "pps"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 34},
      "id": 12,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "title": "Port Drops/s",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "irate(switchdeck_port_rx_dropped_total{switch_name=~\"$switch\"}[5m])",
          "legendFormat": "RX Drop {{switch_name}}:{{port}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "irate(switchdeck_port_tx_dropped_total{switch_name=~\"$switch\"}[5m])",
          "legendFormat": "TX Drop {{switch_name}}:{{port}}",
          "refId": "B"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 42},
      "id": 104,
      "title": "PoE",
      "type": "row"
    },

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2, "fillOpacity": 20, "showPoints": "never"},
          "unit": "watt",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 43},
      "id": 13,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "title": "PoE Budget vs Consumed",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "switchdeck_poe_budget_watts{switch_name=~\"$switch\"}",
          "legendFormat": "Budget — {{switch_name}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "switchdeck_poe_consumed_watts{switch_name=~\"$switch\"}",
          "legendFormat": "Consumed — {{switch_name}}",
          "refId": "B"
        }
      ]
    },

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "watt",
          "min": 0,
          "custom": {"lineWidth": 1, "fillOpacity": 10, "showPoints": "never"}
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 43},
      "id": 14,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "title": "PoE Per-Port Consumption",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "switchdeck_poe_port_watts{switch_name=~\"$switch\"} > 0",
          "legendFormat": "{{switch_name}} port {{port}}",
          "refId": "A"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 51},
      "id": 105,
      "title": "Network Features",
      "type": "row"
    },

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [{"options": {"0": {"color": "orange", "index": 0, "text": "Disabled"}, "1": {"color": "green", "index": 1, "text": "Enabled"}}, "type": "value"}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "orange", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 52},
      "id": 15,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "title": "STP",
      "type": "stat",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "switchdeck_stp_enabled{switch_name=~\"$switch\"}",
          "legendFormat": "{{switch_name}}",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [{"options": {"0": {"color": "orange", "index": 0, "text": "Disabled"}, "1": {"color": "green", "index": 1, "text": "Enabled"}}, "type": "value"}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "orange", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 52},
      "id": 16,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
